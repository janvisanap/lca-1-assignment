import pandas as pd

# Create sample dataset
data = {
    'Name': ['Amit', 'Priya', 'Rahul', 'Sneha', 'Amit'],
    'Marks': [85, 90, None, 78, 85],
    'City': ['Pune', 'Mumbai', 'Pune', None, 'Pune']
}

df = pd.DataFrame(data)

print("Original Dataset:")
print(df)

# Display dataset information
print("\nFirst 5 Rows:")
print(df.head())

print("\nDataset Information:")
df.info()

print("\nStatistical Summary:")
print(df.describe())

# Handle missing values
df['Marks'] = df['Marks'].fillna(df['Marks'].mean())
df['City'] = df['City'].fillna('Unknown')

print("\nAfter Handling Missing Values:")
print(df)

# Remove duplicate records
df = df.drop_duplicates()

print("\nAfter Removing Duplicates:")
print(df)

# Remove an irrelevant column
df = df.drop(columns=['City'])

print("\nAfter Dropping City Column:")
print(df)

# Select data using loc[]
print("\nSelected Student:")
print(df.loc[df['Name'] == 'Priya'])

# Filter students with marks greater than 80
print("\nStudents Scoring Above 80:")
print(df.loc[df['Marks'] > 80])

# Save cleaned dataset
df.to_csv('cleaned_data.csv', index=False)

print("\nCleaned dataset saved successfully.")
